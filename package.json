{
  "name": "rezidence-slovanske-udoli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Prototyp webu Rezidence Slovanské údolí (IKO Plzeň) – statický generátor, data oddělená od UI, bloky = budoucí CMS bloky.",
  "scripts": {
    "build": "node src/build.mjs",
    "build:pages": "BASE_PATH=/rezidence-slovanske-udoli/ node src/build.mjs",
