    "deploy": "bash scripts/deploy-pages.sh",
    "test": "node scripts/test-interactions.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "puppeteer-core": "^23.0.0"
  }
